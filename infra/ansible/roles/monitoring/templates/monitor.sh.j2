#!/usr/bin/env bash
# {{ ansible_managed }}
# flatcraft health monitor. Cron'иться кожні {{ monitor_interval_minutes }} хв.
# Алертить у Discord webhook коли:
#   1. disk usage / > {{ monitor_disk_threshold_pct }}%
#   2. будь-який container зі стека не працює (exited, restarting…) або не healthy
#      (health != "healthy" і != "starting")
#
# State-tracking у /tmp/flatcraft-monitor.state — щоб не спамити webhook кожні 5 хв,
# поки інцидент триває. Шлемо повторно лише після recovery → знову бида.

set -euo pipefail

WEBHOOK_URL="{{ discord_webhook }}"
# MONITOR_STATE_FILE — лише для тесту (tools/scripts/check-monitor-script.test.sh).
STATE_FILE="${MONITOR_STATE_FILE:-/tmp/flatcraft-monitor.state}"
DISK_THRESHOLD={{ monitor_disk_threshold_pct }}

# ─── Notification helper ───────────────────────────────────────────────────
notify() {
    local severity="$1"; shift
    local msg="$*"
    local color
    case "$severity" in
        ERROR) color=15158332 ;;   # red
        OK)    color=3066993  ;;   # green
        *)     color=15844367 ;;   # yellow
    esac
    # Текст — у description (ліміт Discord 4096), а не в title (ліміт 256): 2026-09-25
    # алерт про сім контейнерів мав title на 560 символів, і Discord відповів 400.
    curl -fsS -X POST "$WEBHOOK_URL" \
        -H 'Content-Type: application/json' \
        -d "$(jq -n --arg t "[$severity] flatcraft staging" --arg d "$msg" --argjson c "$color" \
              '{embeds:[{title:$t, description:$d[0:4000], color:$c, timestamp:(now|todateiso8601)}]}')" \
        > /dev/null || { echo "WARNING: Discord notify failed" >&2; return 1; }
}

# State tracking — щоб не спамити поки інцидент триває.
read_state() { [ -f "$STATE_FILE" ] && cat "$STATE_FILE" || echo "OK"; }
write_state() { echo "$1" > "$STATE_FILE"; }

PREV_STATE=$(read_state)
CURRENT_PROBLEMS=()

# ─── 1. Disk usage ─────────────────────────────────────────────────────────
disk_pct=$(df --output=pcent / | tail -1 | tr -dc '0-9')
if [ "$disk_pct" -ge "$DISK_THRESHOLD" ]; then
    CURRENT_PROBLEMS+=("Disk usage / = ${disk_pct}% (threshold ${DISK_THRESHOLD}%)")
fi

# ─── 2. Container health ───────────────────────────────────────────────────
# Контейнери мають імена `flatcraft-<service>-1` (Compose Spec).
# Стан здоров'я — з `docker inspect` (.State.Health.Status: healthy | unhealthy | starting).
# Не з поля `.Status` у `docker ps`: там рядок «Up 5 hours (healthy)», який
# ніколи не дорівнює `healthy`. Так 2026-09-25 монітор застряг у PROBLEM на здорових контейнерах
# і перестав би сповіщати про справжню аварію.
# `docker ps -a`: контейнер, що впав (exited після `on-failure:5` у compose), без `-a` просто
# зникає зі списку, і монітор писав би OK.
while read -r name health status; do
    name=${name#/}
    # Контейнер мусить працювати; з healthcheck — ще й бути healthy (або starting).
    if [[ "$status" != "running" ]] ||
        [[ "$health" != "none" && "$health" != "healthy" && "$health" != "starting" ]]; then
        CURRENT_PROBLEMS+=("Container $name health=$health (state=$status)")
    fi
done < <(docker ps -a -q --filter "name=flatcraft-" \
    | xargs -r docker inspect --format '{% raw %}{{.Name}} {{if .State.Health}}{{.State.Health.Status}}{{else}}none{{end}} {{.State.Status}}{% endraw %}')

# ─── 3. Compose stack: чи є взагалі сервіси? ───────────────────────────────
# Docker, що не відповідає, — теж аварія. Без `if !` помилка тут під `set -e` і `pipefail`
# вбивала б скрипт до алерту (контрприклад рецензента Opus 4.6, 2026-09-25).
if ! running_count=$(docker ps --filter "name=flatcraft-" --format '{{ "{{" }}.Names{{ "}}" }}' | wc -l); then
    CURRENT_PROBLEMS+=("Docker не відповідає: docker ps завершився з помилкою.")
    running_count=0
elif [ "$running_count" -eq 0 ]; then
    CURRENT_PROBLEMS+=("Stack down: 0 containers running.")
fi

# ─── 4. Dispatch ───────────────────────────────────────────────────────────
if [ ${{ "{#" }}CURRENT_PROBLEMS[@]} -gt 0 ]; then
    # Стан міняємо лише тоді, коли сповіщення доставлено: інакше наступний запуск спробує
    # знову. 2026-09-25 перший алерт не дійшов, а стан PROBLEM записався — повтору не було б.
    # Усе, крім PROBLEM (зокрема порожній файл стану), — новий інцидент: інакше порожній
    # файл глушив би алерти назавжди (контрприклад Opus 4.6).
    if [ "$PREV_STATE" != "PROBLEM" ]; then
        # New incident
        msg="🚨 flatcraft staging issue(s):"$'\n'"$(printf '• %s\n' "${CURRENT_PROBLEMS[@]}")"
        if notify ERROR "$msg"; then write_state "PROBLEM"; fi
    fi
    echo "[$(date -u +%FT%TZ)] PROBLEMS: ${CURRENT_PROBLEMS[*]}"
    exit 0
fi

# Все ОК
if [ "$PREV_STATE" = "PROBLEM" ]; then
    # Недоставлене «recovered» не повторюємо: стан OK важливіший. Інакше завислий PROBLEM
    # глушив би алерт про наступну аварію (контрприклад Opus 4.6, 2026-09-25).
    notify OK "✅ flatcraft staging recovered — усі перевірки OK (disk ${disk_pct}%, ${running_count} containers)." || true
fi
write_state "OK"
echo "[$(date -u +%FT%TZ)] OK (disk ${disk_pct}%, ${running_count} containers)"
