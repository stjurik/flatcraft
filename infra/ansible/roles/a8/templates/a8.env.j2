# {{ ansible_managed }}
# Конфіг запобіжників. Читається a8-guard перед КОЖНОЮ задачею.
A8_KILL_SWITCH={{ a8_kill_switch_path }}
A8_DAILY_TASK_LIMIT={{ a8_daily_task_limit }}
A8_CONSECUTIVE_FAILURE_LIMIT={{ a8_consecutive_failure_limit }}
A8_LOGS_DIR={{ a8_logs_dir }}
A8_QUEUE_DIR={{ a8_queue_dir }}
A8_REPO_DIR={{ a8_repo_dir }}
A8_WORKTREES_DIR={{ a8_worktrees_dir }}
# Демон черги (a8-tick)
A8_TASK_TIMEOUT={{ a8_task_timeout_s }}
A8_ORACLE_TIMEOUT={{ a8_oracle_timeout_s }}
A8_MAX_TURNS={{ a8_max_turns }}
# Образ, який запускає a8-run-agent. Тік перевіряє, що він є, ДО того, як узяти
# задачу (issue #117: без образу кожна задача ставала `failed`).
A8_CONTAINER_IMAGE={{ a8_container_image }}
A8_DEFAULT_MODEL={{ a8_default_model }}
# Смуга виконавця gemini (orchestrator-autonomy.md §8, PR-B #262): модель agy за
# замовчуванням, тека налаштувань і логіна agy на хості (тік копіює її на
# задачу) і $HOME контейнера, куди обгортка ставить цю копію.
A8_GEMINI_MODEL={{ a8_gemini_model }}
A8_AGY_CONFIG_DIR={{ a8_agy_config_dir }}
A8_CONTAINER_HOME={{ a8_container_home }}
A8_CLAUDE_TOKEN_FILE={{ a8_claude_token_file }}
A8_PUSH_CREDENTIAL_KIND={{ a8_push_kind }}
A8_PUSH_SSH_URL={{ a8_push_ssh_url }}
# Читає a8-tick-logic.sh: режим (а) OQ-34.
A8_SOURCES_ALLOWED="{{ a8_sources_allowed }}"
