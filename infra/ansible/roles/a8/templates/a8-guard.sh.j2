#!/usr/bin/env bash
# {{ ansible_managed }}
#
# a8-guard — запобіжники автономного прогону. Демон зобов'язаний викликати
# `a8-guard check` ПЕРЕД тим, як узяти задачу з черги, і зупинитись при exit != 0.
#
# ЧОМУ ЦЕ ІСНУЄ ДО ДЕМОНА. docs/19 §7 п.5: «Kill switch і денний ліміт існують
# ДО першого автономного прогону, а не після». Запобіжник, доданий після першої
# ночі, першої ночі не захищає.
#
# ДВА ПИТАННЯ — ДВА ДІЄСЛОВА (рішення yurii 2026-09-20). Раніше дієслово було
# одне, і кликали його обидва: демон — щоб узяти задачу, обгортка a8-run-agent —
# перед КОЖНИМ стартом контейнера. Питання різні, і злиття коштувало дорого:
# денний лічильник інкрементується вже ПІСЛЯ запуску агента, тож будь-який
# наступний виклик обгортки в межах тієї самої задачі (наприклад, прогін оракула
# приймання) на останній дозволеній задачі дня отримував код 11 — і виглядало це
# як провалений оракул, хоча агент зробив усе правильно.
#
#   check      «чи можна БРАТИ НОВУ ЗАДАЧУ» — kill switch + денний ліміт +
#              падіння поспіль. Кличе демон, РІВНО ОДИН раз на задачу.
#   check-run  «чи можна ВЗАГАЛІ щось виконувати» — лише kill switch.
#              Кличе обгортка перед кожним стартом контейнера.
#
# Це не послаблення і не «прапорець обходу»: обидві політики діють, просто
# кожна на своїй межі. Запуск контейнера задачею не є — ліміт задач до нього не
# стосується. А kill switch, єдиний запобіжник, який мусить зупиняти геть усе,
# лишається там, де його перевіряють найчастіше.
#
# ЧОГО ЦЕЙ СКРИПТ НЕ РОБИТЬ: він не зупиняє демона сам. Він дає код виходу і
# рядок причини. Примус — за тим, хто його викликає; скрипт, який убиває чужі
# процеси, страшніший за проблему, яку розв'язує.
#
# Коди виходу:
#   0 — можна
#   10 — kill switch на місці (обидва дієслова)
#   11 — вичерпано денний ліміт задач (лише check)
#   12 — {{ a8_consecutive_failure_limit }} падінь поспіль, черга на паузі (лише check)
set -uo pipefail

CONFIG="{{ a8_config_dir }}/a8.env"
[[ -r "$CONFIG" ]] || {
  echo "a8-guard: немає $CONFIG — відмовляю (fail closed)" >&2
  exit 1
}
# shellcheck disable=SC1090
source "$CONFIG"

TODAY="$(date -u +%Y-%m-%d)"
COUNTER="${A8_LOGS_DIR}/counter-${TODAY}"
STATE="${A8_LOGS_DIR}/last-results"

# Спільна для обох дієслів частина. Kill switch — єдине, що перевіряється
# скрізь: людина, яка його виставила, зупиняє все, а не лише набір нових задач.
kill_switch_or_exit() {
  if [[ -e "$A8_KILL_SWITCH" ]]; then
    echo "STOP: kill switch $A8_KILL_SWITCH на місці"
    exit 10
  fi
}

case "${1:-check}" in
check-run)
  # Межа «старт контейнера». Денний ліміт і пауза тут НЕ перевіряються —
  # див. шапку файла: контейнер не є задачею, а лічильник на цей момент уже
  # інкрементовано демоном.
  kill_switch_or_exit
  echo "OK: kill switch відсутній"
  ;;

check)
  kill_switch_or_exit

  local_count=0
  [[ -r "$COUNTER" ]] && local_count="$(cat "$COUNTER")"
  if ((local_count >= A8_DAILY_TASK_LIMIT)); then
    echo "STOP: денний ліміт вичерпано ($local_count/$A8_DAILY_TASK_LIMIT за $TODAY)"
    exit 11
  fi

  # Три падіння поспіль читаються з хвоста журналу результатів, а не з
  # лічильника: лічильник можна обнулити випадково, хвіст — ні.
  #
  # Нормалізація перед підрахунком — не педантизм. Порожній рядок у кінці файлу,
  # `\r` від DOS-переносу або пробіл після слова зробили б `grep '^failed$'`
  # хибно-негативним, тобто черга продовжила б працювати після трьох падінь.
  # Запобіжник, що мовчки не спрацьовує, гірший за відсутній. Знайдено
  # рев'юером (agy, виклик №2).
  #
  # ПОСПІЛЬ — значить із кінця до першого не-`failed`, а не «скільки failed
  # серед останніх N». Рішення в обох редакціях однакове (зупинка настає рівно
  # тоді, коли останні N усі `failed`), але ЗВІТ відрізнявся: при стані
  # `failed failed ok` вікно давало 2, тоді як падінь поспіль нуль — успіх
  # скинув лічильник. Саме це число yurii побачив 2026-09-20 одразу після
  # успішного прогону і прочитав як «лишилось одне падіння до паузи».
  # Той самий клас, що вписаний нуль у PR #125: повідомлення про стан, яке
  # називає не те, що порахувало.
  tail_n=0
  if [[ -r "$STATE" ]]; then
    tail_n="$(tr -d '\r' <"$STATE" | sed 's/[[:space:]]*$//' | grep -v '^$' |
      tac | awk '$0 != "failed" { exit } { n++ } END { print n + 0 }')"
    if ((tail_n >= A8_CONSECUTIVE_FAILURE_LIMIT)); then
      echo "STOP: $tail_n падінь поспіль — черга на паузі, потрібне втручання"
      exit 12
    fi
  fi

  # $tail_n, а НЕ літерал. Раніше тут стояв вписаний «0», тобто запобіжник
  # звітував числом, якого не обчислював. 2026-09-20 це обдурило живий розбір:
  # у last-results було `failed ok failed failed`, guard друкував «падінь
  # поспіль 0», і з цього зробили висновок, що падіння не накопичуються.
  # Рішення guard ухвалював правильне — хибним був лише його звіт про себе.
  # Той самий клас, що V11-до-виправлення: повідомлення про стан, не пов'язане
  # зі станом.
  echo "OK: задач сьогодні $local_count/$A8_DAILY_TASK_LIMIT, падінь поспіль $tail_n з $A8_CONSECUTIVE_FAILURE_LIMIT"
  ;;

count)
  # Викликається демоном ПІСЛЯ того, як задачу взято.
  local_count=0
  [[ -r "$COUNTER" ]] && local_count="$(cat "$COUNTER")"
  echo $((local_count + 1)) >"$COUNTER"
  ;;

record)
  # a8-guard record <ok|failed>
  result="${2:?потрібен результат: ok|failed}"
  case "$result" in
  ok | failed) echo "$result" >>"$STATE" ;;
  *)
    echo "a8-guard: невідомий результат '$result'" >&2
    exit 1
    ;;
  esac
  ;;

*)
  echo "використання: a8-guard {check|check-run|count|record <ok|failed>}" >&2
  exit 1
  ;;
esac
