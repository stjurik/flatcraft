#!/usr/bin/env python3
# {{ ansible_managed }}
"""Ідемпотентно позначає корінь клону як довірений для Claude Code.

ЧОМУ ЦЕ ОКРЕМИЙ СКРИПТ, А НЕ ЗАДАЧА ANSIBLE. Перша версія ролі робила
slurp + combine + copy(to_nice_json). Сухий прогін показав, що це переписує
ВЕСЬ файл: 973 рядки, відступ 2 → 4, порядок ключів інший. Наслідки обидва
погані — задача «changed» назавжди, і 38 КБ чужого стану переписуються на
кожне застосування, включно з моментом, коли в цій самій теці працює жива
сесія Claude Code.

ЩО РОБИТЬ ЦЕЙ СКРИПТ: читає, дивиться на ОДИН ключ, і якщо він уже `true` —
не пише нічого взагалі. Пише лише коли значення справді треба змінити, і
робить це атомарно (`os.replace`), відступом 2, тобто в тому ж форматі, у
якому файл уже є.

ЧОГО НЕ РОБИТЬ: не створює файл, якщо його немає. Відсутній конфіг означає,
що Claude Code тут ще не запускався; підміна цього факту порожнім файлом
сховала б справжню причину.

Виводить рівно один рядок: CHANGED, OK або MISSING.
"""

import json
import os
import sys
import tempfile

CONFIG = os.path.expanduser("{{ a8_agent_home }}/.claude.json")


def main() -> int:
    target = sys.argv[1] if len(sys.argv) > 1 else "{{ a8_repo_dir }}"

    if not os.path.exists(CONFIG):
        print("MISSING")
        return 3

    with open(CONFIG, encoding="utf-8") as fh:
        data = json.load(fh)

    projects = data.setdefault("projects", {})
    entry = projects.setdefault(target, {})

    if entry.get("hasTrustDialogAccepted") is True:
        print("OK")
        return 0

    entry["hasTrustDialogAccepted"] = True

    directory = os.path.dirname(CONFIG)
    stat = os.stat(CONFIG)
    fd, tmp = tempfile.mkstemp(dir=directory, prefix=".claude.json.")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            json.dump(data, fh, indent=2, ensure_ascii=False)
            fh.write("\n")
        os.chmod(tmp, stat.st_mode & 0o777)
        os.chown(tmp, stat.st_uid, stat.st_gid)
        os.replace(tmp, CONFIG)
    except BaseException:
        os.path.exists(tmp) and os.unlink(tmp)
        raise

    print("CHANGED")
    return 0


if __name__ == "__main__":
    sys.exit(main())
