#!/usr/bin/env bash
# {{ ansible_managed }}
#
# a8-tick — ОДИН тік демона черги: узяти щонайбільше одну задачу, виконати,
# записати, померти. Запускається таймером a8-tick.timer (вимкненим за
# дефолтом) або руками: `sudo -u agent a8-tick`.
#
# ЧОМУ РАЗОВИЙ СКРИПТ, А НЕ ДОВГОЖИВУЧИЙ ПРОЦЕС. ADR-039 §3: стан живе в git і
# черзі на диску, ніколи в пам'яті. Процес, що робить одну задачу і помирає,
# порушити це не може за побудовою: усе, що він знає, він щоразу читає з диска,
# а все, що вирішив, — пише туди ж ДО наступного кроку.
#
# ЛОГІКА РІШЕНЬ — у /usr/local/lib/a8/a8-tick-logic.sh (копія
# tools/scripts/a8-tick-logic.sh, доведена в CI). Тут лише послідовність дій.
# Запуск контейнера — лише через a8-run-agent, запобіжники — лише через
# a8-guard: їхню логіку тут НЕ дублюємо.
#
# СТАН ЗАДАЧІ = ТЕКА, у якій лежить її файл:
#   <queue>/urgent/     — невідкладна: береться ПЕРШОЮ, навіть коли плановий
#                         потік на паузі (a8-queue enqueue --urgent, рішення 19.10)
#   <queue>/*.json      — плановий потік: чекає (береться найменша назва, LC_ALL=C);
#                         на паузі ({{ a8_logs_dir }}/planned-paused, a8-queue
#                         pause) — не береться
#   <queue>/running/    — узята; якщо тік помер, наступний тік знайде її тут
#   <queue>/done/       — агент ok І оракул зелений (далі push або no-credential)
#   <queue>/failed/     — failed; причина — у журналі
#   <queue>/rejected/   — запис невалідний; які саме поля — у журналі
# Задача, зупинена запобіжником або 401, повертається в чергу: її не виконали.
# Без образу агента задачу не беруть зовсім (крок 2a): подія env_broken, не failed.
# Якщо агент уже встиг закомітити — лишається у failed/ з позначкою.
set -uo pipefail

CONFIG="${A8_CONFIG:-{{ a8_config_dir }}/a8.env}"
# shellcheck disable=SC1090
source "$CONFIG" || { echo "a8-tick: немає $CONFIG — відмовляю" >&2; exit 1; }
# Логіка запускається ОКРЕМИМ процесом: без export режим OQ-34 із конфігу до неї
# не доходить, і налаштування ролі було б мертвим (a8-tick.test.sh, сценарій 3b).
export A8_SOURCES_ALLOWED

# Конфіг і скрипти ставить одна й та сама роль, але play може обірватись між
# ними — 2026-09-20 саме так і сталося (задача креденшала впала посередині).
# Тоді новий тік прочитав би старий a8.env, і під `set -u` помер би на
# $A8_ORACLE_TIMEOUT уже ПІСЛЯ прогону агента: година роботи в смітник, у
# журналі — «unbound variable». Перевіряємо тут, до того як узято задачу:
# падіння безкоштовне, а повідомлення називає ліки.
: "${A8_ORACLE_TIMEOUT:?немає в $CONFIG — застосуйте роль ще раз (ansible-playbook a8.yml)}"
: "${A8_CONTAINER_IMAGE:?немає в $CONFIG — застосуйте роль ще раз (ansible-playbook a8.yml)}"

# Точки підміни — ЛИШЕ для тесту (tools/scripts/a8-tick.test.sh). systemd-юніт
# їх не задає, тож на A8 завжди діють шляхи за замовчуванням.
LOGIC="${A8_TICK_LOGIC:-/usr/local/lib/a8/a8-tick-logic.sh}"
GUARD="${A8_GUARD:-/usr/local/bin/a8-guard}"
RUNNER="${A8_RUNNER:-/usr/local/bin/a8-run-agent}"
JOURNAL="${A8_JOURNAL:-/usr/local/bin/a8-journal}"
DOCKER="${A8_DOCKER:-docker}"
# Backstop заборонених шляхів — копія під root, яку агент змінити не може.
FORBIDDEN="${A8_FORBIDDEN_CHECK:-/usr/local/lib/a8/check-forbidden-paths.sh}"
# Як часто спостерігач дивиться на STOP, поки працює контейнер (секунди).
WATCH_S="${A8_WATCH_INTERVAL_S:-5}"

Q="$A8_QUEUE_DIR"
mkdir -p "$Q/running" "$Q/done" "$Q/failed" "$Q/rejected" "$Q/urgent" "$A8_LOGS_DIR/tasks"

# Два тіки одночасно (таймер + ручний запуск) узяли б одну задачу двічі.
exec 9>"$A8_LOGS_DIR/tick.lock"
flock -n 9 || {
  "$JOURNAL" event busy "інший тік ще працює"
  exit 0
}

logic() { bash "$LOGIC" "$@"; }

# ─── hgit: єдиний шлях до git на хості (#276) ──────────────────────────────
# Тік працює на хості від agent, а через групу docker це root. Головний клон
# контейнер агента бачить на запис разом із .git: без цієї обгортки хук чи ключ
# конфігу, підкладений контейнером, виконався б тут, поза allowlist мережі.
#
# Захист у чотири шари, і кожен закриває те, чого не закриває інший:
#   1. a8-run-agent монтує саму `.git` (bind onto self) — тоді `rename(.git)` з
#      контейнера дає EBUSY, бо це точка монтування; `.git/config` і `.git/hooks`
#      (і `.git/worktrees`, якщо є) — поверх, лише для читання. Без шару 1
#      контейнер робив би `mv .git .git-old` і клав свій `.git` (перевірено
#      рецензією #290: без bind самого `.git` перейменування проходить, навіть
#      коли config/hooks — підмонтування; EBUSY дає лише bind на саму `.git`).
#   2. Перевірки git_unsafe_reason (fail closed). Файл, якого в клоні немає,
#      змонтувати наперед не можна, а git знайде його сам: `.git/commondir`
#      переводить git на чужу теку з чужими config і hooks (виміряно на git 2.43);
#      симлінк `.git`/`config`/`hooks`/`worktrees` — те саме; alternates, grafts і
#      shallow підміняють історію та об'єкти (refs/replace вимикає
#      GIT_NO_REPLACE_OBJECTS). ПЛЮС знімок identity: тік перед першим контейнером
#      запам'ятовує dev:inode `.git`, `.git/config`, `.git/hooks` і хеш `config`
#      (`snapshot_git`); якщо після контейнера щось із цього інше — fail closed.
#      Знімок ловить підміну `.git` навіть там, де шару 1 чомусь немає.
#   3. `-c` для кожного ключа, що виконує команду або підміняє, куди йде git,
#      і `core.commitGraph=false` — підроблений `.git/objects/info/commit-graph`
#      міг би збрехати `diff`/`rev-list` про дерево коміту (контрприклад Argon
#      CX2, #290); з вимкненим графом git читає самі об'єкти. Крім uploadpack і
#      receivepack: для них git бере ПЕРШЕ значення, тобто з конфігу репозиторію,
#      а `-c` лише друкує «more than one uploadpack given, using the first»
#      (виміряно на git 2.43). Їх фіксують опції самих команд:
#      `fetch --upload-pack=git-upload-pack`, `push --receive-pack=git-receive-pack`.
#
# ЧОМУ ПЕРЕВІРКА НЕ МАЄ ГОНКИ. Тік викликає git лише тоді, коли контейнера немає.
# `docker run --rm` у a8-run-agent закінчується разом із процесом агента; а якщо
# агента вбито по таймауту, тік спершу ПЕРЕКОНУЄТЬСЯ, що контейнер зник
# (`ensure_container_gone`), і лише тоді кличе git. Доти поміж перевіркою і git
# жоден процес контейнера не живе, щоб змінити `.git` (рецензія #290: раніше код
# `docker kill` проковтувався, і живий контейнер лишав вікно гонки).
#
# МЕЖА. `include.path`, `includeIf` і `filter.<будь-що>.*` через `-c` не
# обнулити: файлові include розкриваються під час читання конфігу, а фільтр
# може мати будь-яке ім'я. Від них захищають шари 1 і 2 (config `:ro` + знімок),
# а не цей список. Порожній `diff.external` git не знімає, а пробує запустити «»
# і падає — тобто нічого не виконує; diff тіку все одно `--name-only`.
#
# `-C "$A8_REPO_DIR"` вшито в обгортку: після контейнера git не працює в
# теці worktree. Контейнер міг переписати "$wt/.git" (файл `gitdir: …`) на
# власний gitdir зі своїм конфігом, хуками й об'єктами. Посилання й об'єкти в
# worktree і головному клоні спільні, тож усе потрібне є тут, за повними
# SHA (`base`, `tip`).
#
# Порушення пише причину в "$unsafe" (його читає finish) і повертає 125:
# git не запускається зовсім, задача стає failed з поясненням.
HGIT_SAFE=(
  -c core.hooksPath=/dev/null
  -c core.fsmonitor=false
  -c core.sshCommand=ssh
  -c core.askPass=
  -c credential.helper=
  -c diff.external=
  -c core.pager=cat
  -c core.editor=false
  -c core.gitProxy=
  -c protocol.ext.allow=never
  -c core.alternateRefsCommand=
  -c core.commitGraph=false
)
# credential.helper — порожній, бо тік на помічника не покладається: fetch іде
# анонімно, push — через GIT_SSH_COMMAND (deploy_key) або GIT_ASKPASS
# (token_file). Помічник із конфігу репозиторію тут лише шкодив би.

# Знімок identity .git — dev:inode трьох шляхів і хеш config. `mv .git .git-old`
# міняє dev:inode `.git`; підміна config міняє хеш. Легка робота агента (коміт у
# worktree) цього не чіпає: config і hooks — `:ro`, а нові об'єкти/рефи inode
# самої теки `.git` не змінюють. Порожній рядок від stat/sha (шлях зник) теж не
# збігається зі знімком — отже теж fail closed.
git_snapshot=""
git_identity() {
  local g="$A8_REPO_DIR/.git"
  stat -c '%d:%i' "$g" "$g/config" "$g/hooks" 2>/dev/null
  sha256sum "$g/config" 2>/dev/null | cut -d' ' -f1
}
snapshot_git() { git_snapshot="$(git_identity)"; }

git_unsafe_reason() { # друкує причину, якщо .git головного клону довіряти не можна
  local g="$A8_REPO_DIR/.git" f
  if [[ -L "$g" || ! -d "$g" ]]; then
    echo ".git — не тека або симлінк"
  elif [[ -e "$g/commondir" || -L "$g/commondir" ]]; then
    echo ".git/commondir існує — git узяв би config і hooks з іншої теки"
  elif [[ -L "$g/config" || ! -f "$g/config" ]]; then
    echo ".git/config — не звичайний файл або симлінк"
  elif [[ -L "$g/hooks" || ! -d "$g/hooks" ]]; then
    echo ".git/hooks — не тека або симлінк"
  elif [[ -L "$g/worktrees" ]]; then
    echo ".git/worktrees — симлінк (чужий gitdir через worktree add)"
  elif [[ -n "$git_snapshot" && "$(git_identity)" != "$git_snapshot" ]]; then
    echo ".git, .git/config чи .git/hooks змінили identity після контейнера"
  else
    for f in objects/info/alternates info/grafts shallow; do
      if [[ -e "$g/$f" || -L "$g/$f" ]]; then
        echo ".git/$f існує — підміняє історію чи об'єкти"
        return 0
      fi
    done
  fi
}
hgit() {
  local why
  why="$(git_unsafe_reason)"
  if [[ -n "$why" ]]; then
    [[ -s "${unsafe:-/dev/null}" ]] || printf '%s\n' "$why" >"${unsafe:-/dev/null}"
    # Зміна identity `.git` ПІСЛЯ знімка — це підміна контейнером, не просто
    # зламаний клон: STOP усієї черги (рецензія #290 коло 2), інакше підмінена
    # `.git` без bind-монтування дожила б до наступного тіку. Решта причин
    # (симлінк, commondir…) може бути й на першому тіку до будь-якого контейнера
    # — там лише fail цієї задачі. noclobber: причину людини не затираємо.
    if [[ "$why" == *"змінили identity"* ]]; then
      (
        set -o noclobber
        printf '.git головного клону підмінено під час задачі %s (%s): %s. git на хості зупинено. Ліки: перевірити %s, відновити клон, зняти %s.\n' \
          "${id:-?}" "$(date -u +%FT%TZ)" "$why" "$A8_REPO_DIR" "$A8_KILL_SWITCH" >"$A8_KILL_SWITCH"
      ) 2>/dev/null
    fi
    echo "a8-tick: небезпечний .git: $why — git не запущено" >&2
    return 125
  fi
  GIT_NO_REPLACE_OBJECTS=1 git "${HGIT_SAFE[@]}" -C "$A8_REPO_DIR" "$@"
}
# Кожне переміщення задачі між теками черги — під queue.lock, тим самим, під яким
# a8-queue enqueue перевіряє «id ще немає, невідкладної немає» і пише, а
# a8-requeue.sh повертає задачу. Інакше перевірка тек по черзі не була б знімком:
# невідкладна, яку тік повертає з running/ в urgent/ посеред перевірки enqueue
# --urgent, не знайшлася б ніде, і в urgent/ лягли б дві (контрприклад 3, PR #272).
# Lock короткий — лише на mv; tick.lock тримається всю задачу, тому він окремий.
qmv() { flock "$A8_LOGS_DIR/queue.lock" mv "$@"; }
# Після таймауту: вбити контейнер і ПЕРЕКОНАТИСЬ, що він зник, перш ніж тік далі
# кличе git (#290). `timeout` убиває лише клієнт `docker run`, не контейнер;
# раніше код `docker kill` проковтувався, і живий контейнер лишав вікно, у якому
# він ще міг міняти `.git` між перевіркою hgit і самим git. `docker run --rm`
# прибирає контейнер, коли той справді зупинився, тож чекаємо, доки inspect
# перестане його бачити. Не зник за відведені спроби → 1 (тік робить fail closed).
ensure_container_gone() { # ensure_container_gone <ім'я контейнера>
  local c="$1" i
  "$DOCKER" kill "$c" >/dev/null 2>&1
  for i in $(seq 1 "${A8_KILL_WAIT_TRIES:-10}"); do
    "$DOCKER" inspect "$c" >/dev/null 2>&1 || return 0
    sleep "${A8_KILL_WAIT_S:-1}"
  done
  return 1
}
# STOP зі зрозумілою причиною й fail closed, коли контейнер не вдалося зупинити:
# живий контейнер — зламане/скомпрометоване середовище, і git на хості чіпати не
# можна. noclobber — не затираємо причину, яку людина могла вписати сама.
container_stuck() { # container_stuck <ім'я контейнера> <коли> <count|nocount>
  (
    set -o noclobber
    printf 'Контейнер %s не зупинився після таймауту (%s), %s. Можливо, ще живий — git на хості не чіпаю. Ліки: перевірити docker на A8, зупинити контейнер, зняти %s.\n' \
      "$1" "$2" "$(date -u +%FT%TZ)" "$A8_KILL_SWITCH" >"$A8_KILL_SWITCH"
  ) 2>/dev/null
  # Задачу зараховуємо в денний ліміт і фіксуємо таймаут у журналі (рецензія #290
  # коло 2): вона дійшла до контейнера й витратила бюджет. На шляху агента
  # лічильник ще не чіпали — рахуємо тут; на шляху оракула його вже збільшено
  # до запуску, тож повторно не рахуємо. oracle_rc=124 — сигнатура таймауту.
  [[ "${3:-}" == count ]] && "$GUARD" count >/dev/null
  oracle_rc=124
  fail_task "таймаут: контейнер $1 не зупинився — git не чіпаю"
  exit 0
}
field() { jq -r --arg k "$1" '.[$k] // "" | tostring' "$2"; }
now() { date +%s; }

# ─── Образ агента: проба і серія env_broken (крок 2a нижче) ───────────────
# image_probe → 0, якщо образ є; інакше в $imsg — перший рядок причини.
# `timeout`, бо завислий docker інакше тримав би flock тіку без кінця: наступні
# тіки писали б `busy`, серія не росла б, і STOP не з'явився б ніколи
# (контрприклад 2.2, PR #232). Таймаут — теж зламане середовище.
INSPECT_S="${A8_INSPECT_TIMEOUT_S:-60}"
streak_file="$A8_LOGS_DIR/env-broken-streak"
image_probe() {
  local rc=0
  imsg="$(timeout "$INSPECT_S" "$DOCKER" image inspect "$A8_CONTAINER_IMAGE" 2>&1 >/dev/null)" || rc=$?
  ((rc == 124)) && imsg="docker image inspect не відповів за ${INSPECT_S} с"
  imsg="${imsg%%$'\n'*}"
  return "$rc"
}
# Серію скидає БУДЬ-ЯКИЙ тік, що бачить образ, — до запобіжників і до черги.
# Інакше її скидав лише тік із задачею, що дійшов до 2a: після ліків при
# порожній черзі, паузі чи STOP стара серія жила далі, і перший разовий збій
# docker одразу ставив STOP (контрприклад 3.1, PR #232). Проба — лише коли серія
# є, тож звичайний тік docker зайвий раз не питає.
if [[ -e "$streak_file" ]] && image_probe; then
  rm -f "$streak_file"
fi

# ─── 0. Сирота з попереднього тіку ─────────────────────────────────────────
# Файл у running/ при вільному lock означає: попередній тік помер посеред
# задачі (OOM, ребут, kill). Що встиг зробити агент — невідомо, тому це failed,
# а не «повторити»: повтор міг би вдруге виконати вже зроблений побічний ефект.
# Worktree і гілку НЕ видаляємо — вони доказ для людини.
for orphan in "$Q"/running/*.json; do
  [[ -e "$orphan" ]] || continue
  oid="$(field id "$orphan")"
  # Тік міг померти, поки агент чи оракул працював: контейнер живе без нагляду.
  # Імена детерміновані (a8-<id>, a8-<id>-oracle), тож убити їх можна й без
  # пам'яті про запуск. Знайдено рев'юером (agy, рев'ю №1 демона); контейнер
  # оракула — рецензією PR #146 (Gemini 3.8 Flash): README обіцяв, код не робив.
  [[ -n "$oid" ]] && "$DOCKER" kill "a8-$oid" "a8-$oid-oracle" >/dev/null 2>&1
  "$GUARD" count >/dev/null
  "$GUARD" record failed
  "$JOURNAL" append "${oid:-unknown}" "$(field source "$orphan")" failed 0 "-" \
    "попередній тік обірвався посеред задачі" \
    exit_class=failed detail=orphan origin="$(field origin "$orphan")" \
    oracle="$(field oracle "$orphan")" branch="ai/${oid}"
  qmv "$orphan" "$Q/failed/"
done

# ─── 1. Запобіжники ────────────────────────────────────────────────────────
grc=0
"$GUARD" check >/dev/null 2>&1 || grc=$?
gstate="$(logic guard-state "$grc")"
if [[ "$gstate" != ok ]]; then
  # Стани не зливаємо: «пауза» і «ліміт» — різні причини, різні ліки.
  "$JOURNAL" event "$gstate" "a8-guard check → $grc"
  [[ "$gstate" == guard_error ]] && exit 1
  exit 0
fi

# ─── 2. Найстаріша ВАЛІДНА задача ──────────────────────────────────────────
# Спершу urgent/, потім плановий потік — якщо він не на паузі. Пауза планового
# потоку (a8-queue pause) не зупиняє ні невідкладну задачу, ні ту, що вже йде.
# Сортування — LC_ALL=C: порядок назв не залежить від локалі машини (у
# en_US.UTF-8 `-` і `_` при порівнянні пропускаються, і «найстаріша» назва
# могла б бути не першою).
candidates() {
  find "$Q/urgent" -maxdepth 1 -type f -name '*.json' | LC_ALL=C sort
  [[ -e "$A8_LOGS_DIR/planned-paused" ]] && return 0
  find "$Q" -maxdepth 1 -type f -name '*.json' | LC_ALL=C sort
}
task=""
while IFS= read -r f; do
  verdict="$(logic validate "$f")" && {
    task="$f"
    break
  }
  # Fail closed: невалідний запис не виконується і не лишається в черзі, щоб
  # не відхилятись щотіку. Журнал називає САМЕ ТІ поля, що відхилили задачу.
  "$JOURNAL" reject "$(basename "$f" .json)" "${verdict#reject }"
  qmv "$f" "$Q/rejected/"
done < <(candidates)

[[ -n "$task" ]] || exit 0

# ─── 2a. Образ агента на місці — ДО того, як узяти задачу ─────────────────
# 2026-10-11 docker-prune видалив образ (issue #117). Обгортка без образу падає
# на першому ж кроці (`docker run` → 125), і задачі ставали `failed`: три
# поспіль — і черга на паузі. Зламане СЕРЕДОВИЩЕ з'їдало задачі, які ні в чому
# не винні.
#
# Тому: задачу не беремо (вона лишається в черзі, у running/ не переходить),
# пишемо подію env_broken (image_missing чи docker_unavailable) і виходимо. Ні `record
# failed`, ні `count`: лічильник падінь і денний ліміт не ростуть. Наступний
# тік перевірить знову; ліки — застосувати роль, вона збирає образ.
#
# Причина — з виміряного: «No such image» (docker 29.8.2, 2026-10-12) — образу
# немає, ліки — роль. Будь-що інше (docker не відповідає, немає доступу, таймаут)
# — docker_unavailable: образ, можливо, на місці, і STOP не має брехати, що його
# немає (контрприклад 2.3, PR #232). Перший рядок stderr іде і в журнал, і в STOP.
#
# СИГНАЛ ЛЮДИНІ. Сама подія в журналі нікого не кличе: тік мовчки виходив би з 0
# кожні 10 хв (рецензія Flash, PR #232). Тому після A8_CONSECUTIVE_FAILURE_LIMIT
# тіків поспіль тік пише kill switch із причиною й ліками — той самий механізм,
# що при 401: STOP видно в пульті й a8-report, а зняти його — рішення людини.
# Одиничний збій (docker саме перезапускається) STOP не ставить.
#
# Серія пишеться атомарно (tmp + mv). `echo >` на повному диску усікав би файл,
# серія застрягала б на 1 і STOP не з'явився б ніколи (контрприклад 3.3). Якщо
# записати серію не вдалось — вести лічбу нічим, тож сигнал одразу.
# STOP пишеться з noclobber: причину, яку людина встигла вписати сама, не затираємо.
if ! image_probe; then
  case "$imsg" in
    *"No such image"*) kind=image_missing ;;
    *) kind=docker_unavailable ;;
  esac
  "$JOURNAL" event env_broken "$kind: $A8_CONTAINER_IMAGE — $imsg"
  prev="$(cat "$streak_file" 2>/dev/null)"
  [[ "$prev" =~ ^[0-9]+$ ]] || prev=0
  streak=$((prev + 1))
  if ! { printf '%s\n' "$streak" >"$streak_file.tmp" && mv -f "$streak_file.tmp" "$streak_file"; } 2>/dev/null; then
    streak="$A8_CONSECUTIVE_FAILURE_LIMIT"
  fi
  if ((streak >= A8_CONSECUTIVE_FAILURE_LIMIT)); then
    if [[ "$kind" == image_missing ]]; then
      why="Образу агента $A8_CONTAINER_IMAGE немає $streak тіків поспіль"
      cure="ansible-playbook a8.yml -i inventory.a8.ini (збирає образ)"
    else
      why="docker не дав перевірити образ $A8_CONTAINER_IMAGE $streak тіків поспіль: $imsg"
      cure="перевірити docker на A8 (systemctl status docker; agent у групі docker)"
    fi
    (
      set -o noclobber
      printf '%s (останній — %s). Ліки: %s, потім rm %s.\n' \
        "$why" "$(date -u +%FT%TZ)" "$cure" "$A8_KILL_SWITCH" >"$A8_KILL_SWITCH"
    ) 2>/dev/null
  fi
  exit 0
fi

id="$(field id "$task")"
src="$(field source "$task")"
origin="$(field origin "$task")"
oracle="$(field oracle "$task")"
model="$(field model "$task")"
model="${model:-$A8_DEFAULT_MODEL}"
branch="ai/$id"
wt="$A8_WORKTREES_DIR/$id"
log="$A8_LOGS_DIR/tasks/$id.log"
# Вивід САМОГО claude — окремо від логу тіку: класифікатор не має бачити
# вивід git/pnpm/check-hook-loud (знайдено незалежним рев'ю №2 демона).
out="$A8_LOGS_DIR/tasks/$id.claude.json"
# Причина, з якої hgit відмовився запускати git (#276). Порожньо — git довіряли.
unsafe="$A8_LOGS_DIR/tasks/$id.git-unsafe"
# `-`, а не 0: «до оракула не дійшло» і «оракул зелений» — різні факти, і в
# журналі вони мусять виглядати по-різному. Дефолт 0 робив би кожну задачу,
# що впала раніше, схожою на прийняту машиною.
oracle_rc="-"

# Узяти = перенести. Від цієї миті задача існує лише в running/ — жоден інший
# тік її вже не побачить у черзі.
claimed="$Q/running/$(basename "$task")"
# Куди повертати задачу, яку не виконали (STOP, 401): туди ж, звідки взяли, —
# невідкладна лишається невідкладною.
home="$(dirname "$task")"
# Узяти — під queue.lock, з повторною перевіркою. Між вибором кандидата (крок 2)
# і цим місцем — проба образу й читання полів, до хвилини. Якщо за цей час
# плановий потік поставили на паузу чи в urgent/ з'явилась задача, планову не
# беремо: наступний тік вибере заново (контрприклад Argon 5б, PR #272).
exec 6>"$A8_LOGS_DIR/queue.lock"
flock 6
if [[ "$home" == "$Q" ]] &&
  { [[ -e "$A8_LOGS_DIR/planned-paused" ]] || compgen -G "$Q/urgent/*.json" >/dev/null; }; then
  exec 6>&-
  exit 0
fi
mv "$task" "$claimed"
exec 6>&-
started="$(now)"
rm -f "$unsafe"

finish() { # finish <результат> <клас> <деталь> <куди>
  # Відмова hgit — перша причина будь-якого наступного падіння (fetch, гілка,
  # push…), тож вона йде в журнал попереду деталі, а не губиться в лозі.
  local detail="$3"
  [[ -s "$unsafe" ]] && detail="небезпечний .git: $(head -n 1 "$unsafe") — $detail"
  "$JOURNAL" append "$id" "$src" "$1" "$(($(now) - started))" "$model" "" \
    exit_class="$2" detail="$detail" origin="$origin" oracle="$oracle" \
    oracle_rc="$oracle_rc" branch="$branch" worktree="$wt"
  if [[ "$4" == queue ]]; then
    qmv "$claimed" "$home/"
  else
    qmv "$claimed" "$Q/$4/"
  fi
}

# Повернути задачу в чергу можна, лише прибравши її порожню гілку і worktree:
# інакше наступний тік побачить «гілка вже існує» і завалить задачу, яку ніхто
# не виконував (знайдено незалежним рев'ю №2 демона). Гілку з комітами НЕ
# чіпаємо — це чиясь робота; тоді задача йде у failed з поясненням.
#
# Коміти — від $base, SHA у пам'яті тіку, а не від origin/main: ref лежить у
# .git, який контейнер бачив на запис, і `update-ref` зробив би «0 комітів» із
# гілки з роботою. Помилку git не перетворюємо на «0» (#276, контрприклад 6):
# не змогли порахувати — гілка й worktree лишаються, задача йде у failed.
# Викликається лише після кроку 3, коли $base уже записано.
# Чому не повернули — у $keep_why: це йде в журнал.
keep_why=""
release_or_keep() {
  local cnt
  if ! cnt="$(hgit rev-list --count "$base..refs/heads/$branch" 2>>"$log")"; then
    keep_why="не вдалось порахувати коміти гілки — гілку й worktree лишаю"
    return 1
  fi
  if [[ "$cnt" != 0 ]]; then
    keep_why="гілка має коміти"
    return 1
  fi
  if ! hgit worktree remove --force "$wt" >>"$log" 2>&1; then
    keep_why="worktree remove не вдався — гілку й worktree лишаю"
    return 1
  fi
  hgit branch -D "$branch" >>"$log" 2>&1
  return 0
}

fail_task() { # fail_task <деталь>
  "$GUARD" record failed
  finish failed failed "$1" failed
  # Паузу ВИСТАВЛЯЄ сам запис `failed` у last-results: a8-guard читає той самий
  # файл і на наступному тіку поверне 12. Тут лише фіксуємо в журналі, на
  # якому саме падінні це сталося.
  if logic should-pause "$A8_CONSECUTIVE_FAILURE_LIMIT" "$A8_LOGS_DIR/last-results" >/dev/null; then
    "$JOURNAL" event paused "$A8_CONSECUTIVE_FAILURE_LIMIT failed поспіль — a8-guard далі повертатиме 12"
  fi
}

# ─── Kill switch посеред задачі ────────────────────────────────────────────
# `a8-guard check` дивиться на STOP перед тим, як узяти задачу, `check-run` —
# перед стартом контейнера. Між ними STOP ніхто не бачив: створений посеред
# сесії агента, він чекав її кінця (до A8_TASK_TIMEOUT, 90 хв), а на
# залежностях чи хуку код 10 від обгортки записувався як `failed deps` /
# `hooks-decorative` — навчальна зупинка додавала падіння до «трьох поспіль».
#
# Мітку пише спостерігач, коли зупиняє контейнер. Код 137 убитого контейнера
# без неї не відрізнити від OOM, а STOP людина могла вже прибрати, поки тік
# дочитував код виходу. 137 без STOP і без мітки — падіння, як і було.
seen="$A8_LOGS_DIR/tasks/$id.stop-seen"
rm -f "$seen"
stop_requested() { [[ -e "$A8_KILL_SWITCH" || -e "$seen" ]]; }

# Зупинка — рішення людини, не падіння: без `record failed`, тож «три поспіль»
# не росте. Задача без комітів повертається в чергу (порожню гілку прибрано),
# з комітами — лишається у failed/ з позначкою: це чиясь робота.
stop_task() { # stop_task <коли: «під час агента», «перед push»…>
  if release_or_keep; then
    finish stopped stopped "kill switch $1" queue
  else
    finish stopped stopped "kill switch $1; $keep_why — не повертаю в чергу" failed
  fi
  exit 0
}

# Спостерігач: поки працює контейнер агента чи оракула, раз на $WATCH_S секунд
# дивиться на STOP. Побачив — пише мітку і подію kill_switch із часом (саме
# цю мить міряє навчальна зупинка), зупиняє СВІЙ контейнер (ім'я — аргумент,
# а не змінна, яку тік потім перепише) і виходить. Прибирається:
#   - після кожного етапу — watch_stop;
#   - при будь-якому виході з тіку, зокрема TERM від systemd, — trap EXIT;
#   - якщо тік убито KILL і trap не спрацював — сам, за один інтервал: `$$` у
#     підоболонці — PID тіку, і `kill -0` бачить, що його вже немає.
#
# Помітивши STOP, спостерігач не виходить, а повторює `docker kill` щоінтервалу,
# доки етап не скінчиться: STOP міг з'явитись, коли обгортка вже пройшла
# check-run, а контейнера ще немає, — перший kill тоді б'є в порожнечу, і
# контейнер працював би всю сесію. Подія в журналі — одна, на першу мить.
watcher=""
watch_start() { # watch_start <контейнер> <коли>
  (
    trap 'kill "$s" 2>/dev/null; exit 0' TERM
    s="" noticed=0
    while kill -0 "$$" 2>/dev/null; do
      if ((noticed)) || [[ -e "$A8_KILL_SWITCH" ]]; then
        if ((!noticed)); then
          noticed=1
          : >"$seen"
          "$JOURNAL" event kill_switch "STOP помічено $2 — зупиняю контейнер $1"
        fi
        "$DOCKER" kill "$1" >/dev/null 2>&1
      fi
      sleep "$WATCH_S" &
      s=$!
      wait "$s"
    done
  ) &
  watcher=$!
}
watch_stop() {
  [[ -n "$watcher" ]] || return 0
  kill "$watcher" 2>/dev/null
  wait "$watcher" 2>/dev/null
  watcher=""
}
trap watch_stop EXIT

# ─── 3. Свіжий worktree від origin/main ────────────────────────────────────
# Лише повні імена посилань (#276, контрприклад 3). Контейнер може створити
# refs/tags/origin/main чи refs/heads/origin/main, і тоді коротке `origin/main`
# неоднозначне: rev-parse бере тег (виміряно на git 2.43), а `worktree add`
# падає з fatal.
if ! hgit fetch --quiet --upload-pack=git-upload-pack origin main >>"$log" 2>&1; then
  "$GUARD" count >/dev/null
  fail_task "git fetch"
  exit 0
fi
if hgit rev-parse --verify --quiet "refs/heads/$branch" >/dev/null || [[ -e "$wt" ]]; then
  # Не перезаписуємо: наявна гілка з тим самим id — чиясь робота.
  "$GUARD" count >/dev/null
  fail_task "гілка $branch або $wt уже існує"
  exit 0
fi
# База для backstop'а (крок 6a) — ЗАПИСАНА ТУТ, у пам'яті тіку, і worktree
# створюється рівно на цьому SHA. Ref origin/main лежить у репозиторії, який
# агент бачить на запис: `git update-ref` зробив би diff від нього порожнім.
base="$(hgit rev-parse --verify --quiet "refs/remotes/origin/main^{commit}")"
[[ -n "$base" ]] && hgit worktree add --quiet -b "$branch" "$wt" "$base" >>"$log" 2>&1
# Merge-base guard: гілка worktree мусить стояти рівно на origin/main.
if [[ -z "$base" || ! -f "$wt/.git" ||
  "$(hgit rev-parse --verify --quiet "refs/heads/$branch^{commit}")" != "$base" ]]; then
  "$GUARD" count >/dev/null
  fail_task "worktree не на origin/main"
  exit 0
fi
# Знімок identity `.git` — ТУТ, після останнього довіреного git і ПЕРЕД першим
# контейнером (крок 4 `pnpm install` уже в контейнері). Далі кожен hgit звіряє:
# якщо контейнер підмінив `.git`/`config`/`hooks`, наступний виклик — fail closed.
snapshot_git

# ─── 4. Залежності і гучний pre-commit ─────────────────────────────────────
# Залежності — у worktree, бо node_modules і venv між worktree не шаруються
# (той самий крок, що в tools/scripts/autorun.sh). Без них хук, навіть знайшовши
# lefthook, запускав би ESLint/tsc/ruff, яких у worktree немає.
#
# Код 10 тут дає лише обгортка (`a8-guard check-run`): STOP з'явився, поки
# ставились залежності чи йшов хук. Це зупинка, а не `failed deps`.
#
# `prepare: lefthook install` ставить хуки не в .git/hooks (у контейнері вона
# лише для читання, #276), а в теку container-home: core.hooksPath для всього
# контейнера задає a8-run-agent. Саме звідти їх потім бачать check-hook-loud.sh
# і git commit агента.
drc=0
"$RUNNER" "$wt" pnpm install --frozen-lockfile >>"$log" 2>&1 || drc=$?
#
# `--extra dev` — як у CI (ci.yml): pytest, mypy і ruff живуть саме там. Без нього
# в контейнері немає pytest для оракула й ruff/mypy для pre-commit (V18e на A8
# 2026-09-29: «Failed to spawn: `pytest`»). Паритет із CI тримає інваріант 11
# у tools/scripts/check-ansible-a8.sh.
if ((drc == 0)); then
  "$RUNNER" "$wt" bash -c 'cd workers/cad && uv sync --extra dev' >>"$log" 2>&1 || drc=$?
fi
if ((drc != 0)); then
  # Зупинка — ДО лічильника: агент не запускався, денний ліміт не витрачено.
  if ((drc == 10)) || stop_requested; then stop_task "під час залежностей"; fi
  "$GUARD" count >/dev/null
  fail_task "deps"
  exit 0
fi
# Інакше лінт і типи в контейнері декоративні: хук друкує попередження і
# пропускає коміт з кодом 0 (вимір №7; повторено на T470 у PR #116).
hrc=0
"$RUNNER" "$wt" bash tools/scripts/check-hook-loud.sh >>"$log" 2>&1 || hrc=$?
if ((hrc != 0)); then
  if ((hrc == 10)) || stop_requested; then stop_task "під час перевірки хука"; fi
  "$GUARD" count >/dev/null
  fail_task "hooks-decorative"
  exit 0
fi
# STOP з'явився, поки йшов хук, а хук устиг скінчитись: агента ще немає —
# зупинка до старту, без лічильника, з чесною назвою етапу.
if stop_requested; then stop_task "перед агентом"; fi

# ─── 5. Агент — лише через a8-run-agent ────────────────────────────────────
# Формулювання пише СУПЕРВІЗОР; текст задачі — дані в ньому (OQ-34 п.3).
prompt="Працюй за CLAUDE.md §0.

Оракул приймання цієї задачі: ${oracle}
Закоміть результат у поточну гілку ${branch}. Не пуш і не створюй PR — це робить супервізор.

ЗАДАЧА:
$(field prompt "$claimed")"

export A8_CONTAINER_NAME="a8-$id"
# Спостерігач — ДО токена: його підоболонці токен у середовищі ні до чого.
watch_start "$A8_CONTAINER_NAME" "під час агента"
# Токен іде через змінну середовища, а не аргумент: аргументи видно в `ps`.
CLAUDE_CODE_OAUTH_TOKEN="$(cat "$A8_CLAUDE_TOKEN_FILE" 2>/dev/null)"
export CLAUDE_CODE_OAUTH_TOKEN

rc=0
timeout "$A8_TASK_TIMEOUT" "$RUNNER" "$wt" claude -p "$prompt" \
  --model "$model" \
  --settings "$wt/.claude/settings.autonomous.json" \
  --dangerously-skip-permissions \
  --max-turns "$A8_MAX_TURNS" \
  --output-format json >"$out" 2>&1 || rc=$?
watch_stop
unset CLAUDE_CODE_OAUTH_TOKEN

# `timeout` вбиває КЛІЄНТ docker run, а не контейнер: без цього агент працював би
# далі без нагляду. Вбиваємо контейнер і переконуємось, що він зник, перш ніж
# нижче кликати git (#290): живий контейнер — вікно гонки над `.git`.
if [[ "$rc" == 124 ]] && ! ensure_container_gone "$A8_CONTAINER_NAME"; then
  container_stuck "$A8_CONTAINER_NAME" "агент" count
fi

# Лічимо ПІСЛЯ запуску. Причина була в тому, що обгортка кликала `a8-guard
# check`, і лічильник, збільшений до запуску, зупинив би останню дозволену
# задачу дня кодом 11. З розділенням дієслів (обгортка кличе `check-run`) ця
# причина ЗНИКЛА: порядок більше ні на що не впливає, і набір це підтвердив —
# мутація «лічильник ДО запуску» перестала вбиватись і була прибрана.
#
# Тобто позиція цього рядка тепер довільна, і це борг, а не рішення.
# Перенести лічильник до запуску варто: тоді вбитий посеред задачі тік не
# лишає її непорахованою, і crash-loop не обходить денний ліміт. Але це зміна
# обліку, а не оракула: разом із нею зникають п'ять розсипаних `count` на
# ранніх гілках падіння і `count` в обробці сироти, інакше задача порахується
# двічі. Власний крок, власні тести.
#
# Що набір тримає ЗАРАЗ: кожна взята задача рахується рівно один раз
# (сценарій 5b + мутація «задача не рахується після запуску»).
"$GUARD" count >/dev/null

# ─── 6. Класифікація ───────────────────────────────────────────────────────
read -r cls detail < <(logic classify "$rc" "$out")
# STOP або мітка спостерігача → зупинка, який би код не повернув контейнер:
# 137 від `docker kill`, 0, якщо агент устиг закінчити, 10 від обгортки.
# Без них 137 іде в класифікатор і стає падінням (OOM, чуже вбивство).
# Виняток — 401: його причина (потрібен claude setup-token) мусить потрапити і
# в журнал, і в сам файл STOP, інакше людина зніме STOP, а наступна задача
# знову впаде на 401.
if [[ "$cls" != auth_stop ]] && stop_requested; then stop_task "під час агента"; fi
case "$cls" in
  auth_stop)
    # STOP усієї черги (ADR-039 §4): потрібен інтерактивний логін. Kill switch —
    # той самий механізм, що в людини; зняти його — рішення людини.
    printf '401 Invalid bearer token у задачі %s, %s. Потрібен claude setup-token.\n' \
      "$id" "$(date -u +%FT%TZ)" >"$A8_KILL_SWITCH"
    if release_or_keep; then
      finish auth_stop auth_stop "$detail" queue
    else
      finish auth_stop auth_stop "$detail; $keep_why — не повертаю в чергу" failed
    fi
    exit 0
    ;;
  stopped)
    if release_or_keep; then
      finish stopped stopped "$detail" queue
    else
      finish stopped stopped "$detail; $keep_why — не повертаю в чергу" failed
    fi
    exit 0
    ;;
  failed)
    fail_task "$detail"
    exit 0
    ;;
  ok) ;;
  *)
    # FAIL CLOSED. Порожній або невідомий клас (класифікатор упав, файл логіки
    # відсутній) — це падіння, а не «мабуть, успіх». Без цієї гілки порожній
    # $cls проходив повз case і задача йшла на push і в done/. Знайдено
    # рев'юером (agy, рев'ю №1 демона).
    fail_task "classifier: '${cls:-}'"
    exit 0
    ;;
esac

# ok від моделі ще не означає, що є результат. Рахуємо від бази до ГІЛКИ, що
# пушиться: `origin/main..HEAD` зарахував би коміт на відокремленому HEAD, і
# гілку без змін запушило б як «ok» (знайшов рецензент agy, Gemini 3.8 Flash).
# SHA вершини закріплюється тут; його ж перевіряє backstop і пушить крок 7.
# Читаємо з головного клону, не з "$wt": контейнер міг переписати "$wt/.git".
# Помилка rev-list — теж «комітів немає»: задача failed, нічого не пушиться.
tip="$(hgit rev-parse --verify --quiet "refs/heads/$branch^{commit}")"
ncommits=""
[[ -n "$tip" ]] && ncommits="$(hgit rev-list --count "$base..$tip" 2>>"$log")"
if [[ -z "$tip" || -z "$ncommits" || "$ncommits" == 0 ]]; then
  fail_task "no-commits"
  exit 0
fi

# ─── 6a. Backstop заборонених шляхів — до оракула і push ──────────────────
# CLAUDE.md §6.1 обіцяє для A8 «deny-правила + backstop-скрипт». Deny-правила
# ловлять Edit/Write, а не Bash: `echo > infra/x` чи `git mv CLAUDE.md …` їх
# минають. Без цього кроку заборонене доходило б до push (a8-tick.test.sh,
# сценарії 19).
#
# Що саме перевіряється і чому так:
#   - база — SHA, записаний при створенні worktree, а не origin/main (агент
#     може пересунути ref);
#   - вершина — гілка, яка пушиться, а не HEAD: відокремлений HEAD на чистому
#     коміті ховав би заборонений коміт на гілці. SHA вершини закріплюється тут
#     і саме він пушиться в кроці 7 — оракул нижче виконує код агента і міг би
#     зсунути гілку вже після перевірки;
#   - `--no-renames`: інакше перенесення CLAUDE.md показало б лише нову назву;
#   - GIT_NO_REPLACE_OBJECTS (у hgit): `git replace` підміняє вміст для diff,
#     але push віддає справжні об'єкти;
#   - головний клон, а не "$wt": gitdir worktree контейнер міг підмінити на
#     власний, з об'єктом під тим самим SHA, у якому забороненого файла немає
#     (git не перераховує хеш об'єкта, читаючи його для diff). МЕЖА: так само
#     підроблений об'єкт у .git/objects самого головного клону (він записуваний
#     з контейнера) цей крок не ловить — поза #276;
#   - `-z`: без нього git бере в лапки шлях із кирилицею чи лапками
#     ("infra/\321\202…"), і шаблон ^infra/ його не бачить (знайшов рецензент
#     agy, Gemini 3.8 Flash). NUL → перевод рядка: ім'я з переводом рядка дасть
#     зайвий рядок, але перший шматок забороненого шляху зберігає префікс.
bout=""
if ! changed="$(hgit diff -z --name-only --no-renames "$base" "$tip" 2>>"$log" | tr '\0' '\n')" ||
  ! bout="$(printf '%s\n' "$changed" | bash "$FORBIDDEN" 2>&1)"; then
  printf '%s\n' "$bout" >>"$log"
  viol="$(sed -n 's/^  ✗ //p' <<<"$bout" | tr '\n' ' ')"
  # Порожній перелік — це не «заборонене не знайдено», а «перевірку не
  # виконано»: git diff упав або скрипта немає. Fail closed, але з поясненням.
  fail_task "forbidden-paths: ${viol:-перевірку не виконано — git diff або скрипт упали, див. лог задачі}"
  exit 0
fi

# ─── 6b. Оракул приймання — доводить МАШИНА ────────────────────────────────
# `ok` від моделі означає лише «сесія завершилась без помилки», а коміти —
# лише «щось записано». ЩО саме записано, доводить оракул із запису черги.
#
# Урок, через який цей крок існує: 2026-09-20 задача під слабким оракулом
# завершилась зеленою, а в тексті, який написав агент, було вигадане число.
# Упіймало його око, не машина (docs/02 п.4: оракул зараховується, лише якщо
# він червоніє на НЕПРАВИЛЬНОМУ результаті, а не тільки на відсутньому).
#
# Оракул іде ЧЕРЕЗ ТУ САМУ обгортку, що й агент: те саме дерево, ті самі
# node_modules, той самий PATH. Прогнати його на хості означало б перевіряти
# іншим інструментом, ніж той, яким працювали, — і вважати збіг доказом.
#
# ПОРЯДОК: до push'а. Віддавати назовні неперевірений результат — саме те,
# заради чого оракул і заводився.
#
# Код у `detail` пишеться як є: `rc=124` — вичерпано A8_ORACLE_TIMEOUT,
# `rc=10` без kill switch неможливий (його ловить гілка нижче), решта — від
# самого оракула. Окремих назв для кожного коду немає навмисно: класифікатор
# матчить лише сигнатури, реально бачені в логах (CLAUDE.md §0 п.3).
oracle_container="a8-$id-oracle"
A8_CONTAINER_NAME="$oracle_container"
export A8_CONTAINER_NAME
orc=0
watch_start "$oracle_container" "під час оракула"
timeout "$A8_ORACLE_TIMEOUT" "$RUNNER" "$wt" bash -c "$oracle" >>"$log" 2>&1 || orc=$?
watch_stop
# Як і в агента: контейнер оракула має зникнути, перш ніж тік далі кличе git (#290).
if [[ "$orc" == 124 ]] && ! ensure_container_gone "$oracle_container"; then
  container_stuck "$oracle_container" "оракул" nocount
fi
oracle_rc="$orc"

if ((orc != 0)); then
  # Kill switch, виставлений посеред задачі, теж дає ненульовий код — але його
  # повертає обгортка (`a8-guard check-run` → 10) чи `docker kill` спостерігача
  # (137), а не оракул. Не розрізнивши ці випадки, демон записав би «оракул
  # червоний» там, де людина натиснула стоп, і звинуватив би агента в чужому
  # рішенні. Код 10 сам по собі тут не доказ: його може повернути й оракул.
  if stop_requested; then stop_task "під час оракула"; fi
  fail_task "oracle rc=$orc"
  exit 0
fi

# ─── 6c. Останній погляд на STOP — перед тим, як віддати назовні ───────────
# Оракул зелений, але STOP могли створити, поки він ішов чи щойно після. Push —
# єдиний крок, що виходить за межі A8: після нього «зупинити» вже нічого.
# Гілка з комітами лишається локально, задача — у failed/ з позначкою.
if stop_requested; then stop_task "перед push"; fi

# ─── 7. Push — лише якщо креденшал заданий ─────────────────────────────────
case "$A8_PUSH_CREDENTIAL_KIND" in
  none)
    # Не «успіх»: результат є, але він нікуди не віддався (вимір №7).
    "$GUARD" record ok
    finish no-credential ok "push пропущено: креденшала немає" done
    ;;
  deploy_key)
    if GIT_SSH_COMMAND="ssh -i $HOME/.ssh/id_push -o IdentitiesOnly=yes -o BatchMode=yes" \
      hgit push --receive-pack=git-receive-pack "$A8_PUSH_SSH_URL" "$tip:refs/heads/$branch" >>"$log" 2>&1; then
      "$GUARD" record ok
      finish ok ok pushed done
    else
      fail_task push
    fi
    ;;
  token_file)
    if GIT_ASKPASS=/usr/local/bin/a8-git-askpass GIT_TERMINAL_PROMPT=0 \
      hgit push --receive-pack=git-receive-pack origin "$tip:refs/heads/$branch" >>"$log" 2>&1; then
      "$GUARD" record ok
      finish ok ok pushed done
    else
      fail_task push
    fi
    ;;
  *)
    fail_task "невідомий A8_PUSH_CREDENTIAL_KIND"
    ;;
esac
exit 0
