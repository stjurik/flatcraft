# {{ ansible_managed }}
#
# Закриває вікно без egress-фільтра після старту/рестарту docker.
#
# Правила примусу вставляються `iptables -I` і не переживають ребут. Що їх
# скидає також `ufw reload` — УСПАДКОВАНЕ ПРИПУЩЕННЯ з PR #116, виведене з
# рядка `:DOCKER-USER - [0:0]` у /etc/ufw/after.rules, а не виміряне: вимір
# потребував би запису на A8. Ручний drop-in docker.service.d/ufw-reload.conf
# робить `ufw reload` після КОЖНОГО старту docker.
#
# ІМ'Я ФАЙЛА — ЧАСТИНА МЕХАНІЗМУ. ExecStartPost з різних drop-in'ів
# виконуються послідовно в порядку імен файлів. «zz-» ставить цей після
# «ufw-reload.conf»: спершу ufw перечитує ланцюг, потім ми повертаємо правила.
# Під іменем «a8-…» він би виконався ПЕРЕД ufw reload, і той би їх стер.
#
# «-» перед командою: збій оновлення allowlist'а не має права зупинити docker.
# Таймер a8-egress-refresh лишається другим рубежем (ufw reload руками,
# збій цієї команди).
[Service]
ExecStartPost=-/usr/local/bin/a8-egress-refresh
